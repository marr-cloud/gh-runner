# Copy to .env. Only the lines for your scope and auth method are needed.

# Image: noble (Ubuntu 24.04) or resolute (Ubuntu 26.04); add -docker for the Docker CLI.
RUNNER_IMAGE=meitrix8208/gh-runner:noble
RUNNERS=2

# Scope
RUNNER_SCOPE=org
ORG_NAME=your-org
#REPO_URL=https://github.com/your-org/your-repo

# Authentication: a PAT or a GitHub App (see docs/Authentication.md)
ACCESS_TOKEN=
#APP_ID=
#APP_PRIVATE_KEY=

RUNNER_NAME=gh-runner
LABELS=self-hosted,linux
EPHEMERAL=true
